{
  "name": "gamepilot",
  "version": "1.9.0",
  "description": "A local-first PC gaming library manager and launcher.",
  "private": true,
  "main": "electron.js",
  "homepage": "./",
  "author": "GamePilot Team",
  "dependencies": {
    "axios": "^1.13.5",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "discord-rpc": "^4.0.1",
    "html2canvas": "^1.4.1",
    "https-browserify": "^1.0.0",
    "lucide-react": "^0.575.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "react-scripts": "5.0.1",
    "recharts": "^3.7.0",
    "sql.js": "^1.12.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "systeminformation": "^5.31.4",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "jest",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron": ".\\node_modules\\.bin\\electron.cmd .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && set ELECTRON_ENABLE_RELOADER=true&& .\\node_modules\\.bin\\electron.cmd .\"",
    "electron-dev-win": "concurrently \"npm start\" \"wait-on http://localhost:3001 && set ELECTRON_ENABLE_RELOADER=true&& electron .\"",
    "build-electron": "npm run build && electron-builder",
    "build-electron-win": "npm run build && electron-builder --win",
    "build-electron-mac": "npm run build && electron-builder --mac",
    "build-electron-linux": "npm run build && electron-builder --linux",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"*.js\" \"vite.config.js\" \"jest.config.js\" \"babel.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"*.js\" \"vite.config.js\" \"jest.config.js\" \"babel.config.js\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.css\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "globals": {
      "__APP_VERSION__": "readonly"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@vitejs/plugin-react": "^4.3.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "react-app-rewired": "^2.2.1",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-no-unsupported-browser-features": "^8.0.1",
    "vite": "^5.4.8",
    "vite-plugin-node-polyfills": "^0.22.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.gamepilot.app",
    "productName": "GamePilot",
    "npmRebuild": false,
    "extraMetadata": {
      "main": "electron.js"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/renderer/**/*",
      "node_modules/**/*",
      "electron.js",
      "logger.js",
      "electron/**/*",
      "discordPresence.js",
      "sessionDatabase.js",
      "launchHandler.js",
      "nativeLibraryScanner.js",
      "public/preload.js",
      "public/gamepilot.ico.ico",
      "public/gamepilotlogo.png",
      "src/services/scanner/**/*",
      "src/GameGenreDatabase.js"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "public/gamepilot.ico.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "public/gamepilotlogo.png",
      "maintainer": "Moz",
      "artifactName": "GamePilot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
