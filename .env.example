# GamePilot environment variables
#
# These are optional. GamePilot is local-first and works without any API keys.
# The Steam API key (if used) is consumed server-side by the Netlify function
# in netlify/functions/getSteamGames.js — it must be set as STEAM_API_KEY
# (not REACT_APP_STEAM_API_KEY) in your Netlify dashboard or server environment.

# Optional: enable HLTB debug logging in the renderer
REACT_APP_GAMEPILOT_HLTB_DEBUG=false

# Optional: enable scanner debug logging (main process)
GAMEPILOT_SCANNER_DEBUG=false

# Optional: enable HLTB debug logging in the main process
GAMEPILOT_HLTB_DEBUG=false
